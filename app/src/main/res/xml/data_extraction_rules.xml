<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup/transfer rules — a DELIBERATE SPLIT, not a blanket disable.

   NEVER to the cloud. `pandapools_ownpools` carries each pool's recovery recipe including the seed-derived
   owner pubkey `opk`, owner address `oadr`, key index `kidx` and the authoritative covenant `script`
   (OwnPoolStore.java:26,35-49). Uploading that describes exactly what a user owns and how it is derived, and
   restoring it onto a node with a DIFFERENT seed re-plants ownership claims that node cannot satisfy —
   `SIGNEDBY(opk)` simply fails, so the pools look like the user's but cannot be reclaimed.

   Device transfer keeps `pandapools_ownpools` ONLY, because the recipe is deliberately node-independent:
   OwnPoolStore's own header states that seed + recipe = always reclaimable, including on a resynced node or
   a new phone. That guarantee only holds for the SAME seed, which is precisely what a same-user device
   transfer is. Ledgers, activity, address book and the tx cache are all rebuildable from chain, so they stay
   excluded from both channels.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <!-- An <include> makes this section allow-list only: the ledgers, activity, address book and tx cache are
         excluded implicitly because they are not named here. Do not add <exclude> entries alongside it —
         paths outside an included path are a lint error, not extra safety. -->
    <device-transfer>
        <include domain="sharedpref" path="pandapools_ownpools.xml" />
    </device-transfer>
</data-extraction-rules>
