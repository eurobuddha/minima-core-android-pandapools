<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules. This file cannot express the cloud-vs-transfer split that
   data_extraction_rules.xml uses on Android 12+, and the sensitive store here — `pandapools_ownpools`, the
   pool recovery recipes carrying seed-derived `opk`/`kidx` — must never reach a cloud. So on old devices we
   back up NOTHING.

   Consequence, accepted deliberately: on API < 31 the recipes are not carried by Auto Backup. They remain
   reconstructible from the same seed, and Android 12+ device transfer still carries them — see
   data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
